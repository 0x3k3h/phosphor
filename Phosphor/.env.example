# ─────────────────────────────────────────────────────────────────────────────
#  PHOSPHOR CONFIGURATION
#  Copy this file to `.env` and edit. Every value is overridable by a real
#  environment variable of the same name.
# ─────────────────────────────────────────────────────────────────────────────

# A long random string. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
PHOSPHOR_SECRET_KEY=change-me-please-use-a-real-random-secret

# The domain you send mail AS by default (you can add more in the GUI).
PHOSPHOR_PRIMARY_DOMAIN=example.com

# The A-record hostname of THIS server. Must resolve to this box's public IP,
# and that IP's reverse DNS (PTR) should point back to this name.
PHOSPHOR_SERVER_HOSTNAME=mail.example.com

# Public base URL the GUI + tracking links + unsubscribe pages are reached at.
# Use https:// in production (put Phosphor behind a TLS reverse proxy).
PHOSPHOR_PUBLIC_URL=http://localhost:8000

# ── Network ports ────────────────────────────────────────────────────────────
PHOSPHOR_API_HOST=0.0.0.0
PHOSPHOR_API_PORT=8000
PHOSPHOR_SMTP_INBOUND_HOST=0.0.0.0
PHOSPHOR_SMTP_INBOUND_PORT=25
PHOSPHOR_SMTP_SUBMISSION_PORT=587

# ── Sending policy (safety rails for cold outreach) ──────────────────────────
PHOSPHOR_OUTBOUND_ENABLED=true
# Hard ceiling across ALL campaigns, per rolling hour.
PHOSPHOR_MAX_SEND_PER_HOUR=60
PHOSPHOR_DKIM_SELECTOR=phosphor

# ── TLS for the SMTP listeners (optional but strongly recommended) ───────────
# Point these at your certbot / Let's Encrypt PEM files.
PHOSPHOR_TLS_CERT_FILE=
PHOSPHOR_TLS_KEY_FILE=

# ── Auth ────────────────────────────────────────────────────────────────────
PHOSPHOR_ACCESS_TOKEN_TTL_MINUTES=1440

# ── CORS ────────────────────────────────────────────────────────────────────
# Origins allowed to call the API (comma-separated). The KlickMail desktop
# client runs from http://localhost:8765 by default. "*" is safe here (bearer
# token only, no cookies) but you can lock it down, e.g.:
#   PHOSPHOR_CORS_ORIGINS=http://localhost:8765,https://mail.example.com
PHOSPHOR_CORS_ORIGINS=*

# ── Storage ─────────────────────────────────────────────────────────────────
# Leave DATABASE_URL blank to use the bundled SQLite file in ./data
PHOSPHOR_DATABASE_URL=
